PORT=3001
# Exact frontend origin (no trailing slash). In prod this is the only allowed CORS origin.
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# SQLite file location. In production point at a persistent volume, e.g. /data/data.db
# DATABASE_PATH=/data/data.db

# Stripe — secret and publishable keys must be the same mode (both test or both live).
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the endpoint registered at <api-url>/webhooks/stripe in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Gemini (fit checker + AI recolor). Key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_FIT_MODEL=gemini-flash-latest
# GEMINI_MODEL=gemini-2.5-flash-image
# FIT_CHECK_DAILY_LIMIT=300
